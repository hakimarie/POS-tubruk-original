<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kasir POS Lite - Dine In</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body { font-family: 'Inter', sans-serif; }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

  #printStrukArea { display: none; }
  @media print {
    @page { margin: 0; size: 58mm auto; }
    body * { visibility: hidden; }
    #printStrukArea, #printStrukArea * { visibility: visible; }
    #printStrukArea {
      display: block; position: absolute; left: 50%; top: 0;
      transform: translateX(-50%); width: 58mm;
      font-family: 'Courier New', Courier, monospace; font-size: 12px;
      color: #000; padding: 15px; margin: 0 auto;
    }
  }
</style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased h-screen overflow-hidden flex flex-col">

<!-- CEK SESI LOGIN & URL APP SCRIPT -->
<script>
  let currentUser = null;
  try {
    const userSession = localStorage.getItem('iMersWA_User');
    if (!userSession) {
      window.location.replace('login.html');
    } else {
      currentUser = JSON.parse(userSession);
    }
  } catch (e) { console.error("Error cek sesi:", e); }

  // URL WEB APP GOOGLE APPS SCRIPT (samain dengan dashboard.html)
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwebuvQXQ836tdBdL82G-88tQsVLmFBjPsX412XKjvkfJm_aGrlzlcMEtuRXxqntKvEEA/exec';
</script>

<!-- Header -->
<header class="h-14 bg-white border-b border-slate-200 flex items-center justify-between px-4 shrink-0 shadow-sm">
  <div class="flex items-center gap-2">
    <i data-lucide="calculator" class="w-5 h-5 text-emerald-600"></i>
    <h1 class="font-bold text-slate-800 text-sm sm:text-base">Kasir POS <span class="text-emerald-600">· Dine In</span></h1>
  </div>
  <div class="flex items-center gap-3">
    <span class="text-xs sm:text-sm text-slate-500 font-medium hidden sm:block" id="uiUsername">@user</span>
    <a href="dashboard.html" class="text-xs text-slate-400 hover:text-slate-600 flex items-center gap-1">
      <i data-lucide="layout-dashboard" class="w-4 h-4"></i> <span class="hidden sm:inline">Dashboard</span>
    </a>
    <button onclick="doLogout()" class="text-xs text-red-500 hover:text-red-600 flex items-center gap-1">
      <i data-lucide="log-out" class="w-4 h-4"></i> <span class="hidden sm:inline">Keluar</span>
    </button>
  </div>
</header>

<!-- Main -->
<main class="flex-1 overflow-hidden flex flex-col lg:flex-row gap-3 p-3">

  <!-- Kiri: Produk -->
  <div class="flex-1 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col min-h-[45vh] lg:min-h-0">
    <div class="p-3 border-b border-slate-100 bg-slate-50 flex items-center gap-2 shrink-0">
      <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
      <input type="text" id="posSearch" placeholder="Cari produk..." oninput="filterPOS()" class="w-full bg-transparent border-none focus:outline-none text-sm font-medium">
    </div>
    <div class="p-3 overflow-y-auto flex-1 bg-slate-50">
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3" id="posProductGrid">
        <div class="col-span-full text-center text-slate-400 py-10 text-sm">Memuat produk...</div>
      </div>
    </div>
  </div>

  <!-- Kanan: Keranjang -->
  <div class="w-full lg:w-96 shrink-0 bg-white rounded-xl border border-slate-200 shadow-sm flex flex-col min-h-[40vh] lg:min-h-0">
    <div class="p-3 border-b border-slate-100 bg-emerald-500 text-white flex justify-between items-center rounded-t-xl shrink-0">
      <h3 class="font-bold text-sm flex items-center gap-2"><i data-lucide="shopping-cart" class="w-4 h-4"></i> Keranjang</h3>
      <button onclick="clearCart()" class="text-xs bg-emerald-600 hover:bg-emerald-700 px-2 py-1 rounded transition-colors">Kosongkan</button>
    </div>
    <div class="flex-1 overflow-y-auto p-3 space-y-2" id="cartItemList">
      <div class="text-center text-slate-400 text-sm mt-10">Keranjang masih kosong</div>
    </div>
    <div class="p-3 border-t border-slate-100 bg-slate-50 rounded-b-xl space-y-2 shrink-0">
      <div class="flex justify-between items-center text-sm font-medium text-slate-600">
        <span>Subtotal</span><span id="cartSubtotalVal">Rp 0</span>
      </div>
      <button onclick="openCheckoutModal()" class="w-full py-3 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 shadow-lg flex justify-center items-center gap-2 transition-all text-sm">
        <i data-lucide="arrow-right-circle" class="w-5 h-5"></i> Lanjut Pembayaran
      </button>
    </div>
  </div>
</main>

<!-- Modal Checkout -->
<div id="checkoutModal" class="fixed inset-0 z-[100] hidden">
  <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeModal('checkoutModal')"></div>
  <div class="flex items-center justify-center min-h-screen px-4 py-8">
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden z-10 flex flex-col max-h-[90vh]">
      <div class="px-5 py-4 flex justify-between items-center border-b border-slate-100 bg-slate-50 shrink-0">
        <h3 class="font-bold text-lg text-slate-800">Pembayaran Dine In</h3>
        <button onclick="closeModal('checkoutModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div class="p-5 space-y-4 flex-1 overflow-y-auto">

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-emerald-600 mb-1">Nomor Meja <span class="text-red-500">*</span></label>
            <input type="text" id="coMeja" required class="w-full px-3 py-2 border border-emerald-200 rounded-lg text-sm font-bold" placeholder="Cth: 5">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Nama Pembeli</label>
            <input type="text" id="coNama" class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="Opsional">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Pesanan</label>
          <textarea id="coCatatan" rows="2" class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="Cth: Pedas level 2, tanpa es, dll (opsional)"></textarea>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-1">
          <div class="flex justify-between text-xs text-slate-500 hidden" id="coPpnRow"><span>PPN:</span><span id="coPpnVal">Rp 0</span></div>
          <div class="flex justify-between text-xs text-slate-500 hidden" id="coBiayaLayananRow"><span>Biaya Layanan:</span><span id="coBiayaLayananVal">Rp 0</span></div>
          <div class="flex justify-between items-end pt-1">
            <span class="text-sm font-bold text-slate-800">Grand Total:</span>
            <span class="text-xl font-black text-slate-900" id="coGrandTotal">Rp 0</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Metode Pembayaran</label>
          <select id="coMethod" class="w-full px-3 py-2.5 border rounded-lg text-sm font-bold bg-white" onchange="toggleKembalian()">
            <option value="Cash">Tunai (Bayar di Kasir)</option>
            <option value="QRIS">QRIS</option>
            <option value="Transfer">Transfer Bank</option>
          </select>
        </div>

        <div id="cashArea" class="bg-blue-50 p-4 rounded-xl border border-blue-100">
          <label class="block text-xs font-bold text-blue-800 mb-1">Uang Diterima (Rp)</label>
          <input type="number" id="coUangDiterima" class="w-full px-3 py-2.5 border border-blue-200 rounded-lg text-lg font-bold" oninput="hitungKembalian()">
          <div class="flex justify-between items-center mt-3 pt-3 border-t border-blue-200">
            <span class="text-sm font-bold text-blue-600">Kembalian:</span>
            <span class="text-xl font-black text-blue-700" id="coKembalian">Rp 0</span>
          </div>
        </div>
      </div>
      <div class="p-4 bg-white border-t border-slate-100 shrink-0">
        <button onclick="submitCheckout()" id="btnSubmitCheckout" class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-lg">Konfirmasi & Cetak</button>
      </div>
    </div>
  </div>
</div>

<!-- STRUK THERMAL (HIDDEN, UNTUK PRINT) -->
<div id="printStrukArea">
  <div style="text-align:center; margin-bottom:10px;">
    <h2 id="strNamaToko" style="margin:0; font-size:16px;">NAMA TOKO</h2>
    <p id="strInfoToko" style="margin:0; font-size:10px;"></p>
  </div>
  <div style="border-bottom:1px dashed #000; margin-bottom:5px; padding-bottom:5px;">
    <p style="margin:0;">No: <span id="strOrderId"></span></p>
    <p style="margin:0;">Tgl: <span id="strDate"></span></p>
    <p style="margin:0; font-weight:bold;">MEJA: <span id="strMeja"></span></p>
    <p style="margin:0;">Ksr: <span id="strKasir"></span></p>
    <p style="margin:0;">Plg: <span id="strPelanggan"></span></p>
    <p id="strCatatanRow" style="margin:0; display:none;">Ctt: <span id="strCatatan"></span></p>
  </div>
  <div id="strItems" style="border-bottom:1px dashed #000; margin-bottom:5px; padding-bottom:5px;"></div>
  <div style="border-bottom:1px dashed #000; margin-bottom:5px; padding-bottom:5px;">
    <div style="display:flex; justify-content:space-between;"><span>Subtotal:</span><span id="strSubtotal"></span></div>
    <div id="strPpnRow" style="display:none; justify-content:space-between;"><span>PPN:</span><span id="strPpn"></span></div>
    <div id="strServiceRow" style="display:none; justify-content:space-between;"><span>Layanan:</span><span id="strService"></span></div>
  </div>
  <div style="border-bottom:1px dashed #000; margin-bottom:5px; padding-bottom:5px;">
    <div style="display:flex; justify-content:space-between; font-weight:bold; font-size:14px;"><span>Total:</span><span id="strTotal"></span></div>
    <div style="display:flex; justify-content:space-between;"><span>Bayar (<span id="strMethod"></span>):</span><span id="strTunai"></span></div>
    <div style="display:flex; justify-content:space-between;"><span>Kembali:</span><span id="strKembali"></span></div>
  </div>
  <div style="text-align:center; margin-top:10px;">
    <p style="margin:0;">Selamat Menikmati!</p>
    <p style="margin:0; font-size:9px;">Powered by iMersWAstore</p>
  </div>
</div>

<script>
  const formatRupiah = (angka) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);

  let globalProducts = [];
  let cart = [];
  let posSubtotal = 0, posPpnVal = 0, posServiceVal = 0, posGrandTotal = 0;

  function doLogout() {
    localStorage.removeItem('iMersWA_User');
    window.location.href = 'login.html';
  }

  async function apiCall(action, paramsObj = {}) {
    const formData = new FormData();
    formData.append('action', action);
    if (currentUser && currentUser.id && currentUser.token) {
      formData.append('requestor_id', currentUser.id);
      formData.append('requestor_token', currentUser.token);
    }
    for (const key in paramsObj) formData.append(key, paramsObj[key]);
    try {
      const res = await fetch(SCRIPT_URL, { method: 'POST', body: formData });
      return await res.json();
    } catch (err) {
      return { success: false, message: "Koneksi terputus. Silakan coba lagi." };
    }
  }

  async function loadProducts() {
    const res = await apiCall('get_products');
    if (res.success) {
      globalProducts = res.data;
      renderPOSGrid(globalProducts);
    } else {
      document.getElementById('posProductGrid').innerHTML = `<div class="col-span-full text-center text-red-400 py-10 text-sm">Gagal memuat produk.</div>`;
    }
  }

  function filterPOS() {
    const query = document.getElementById('posSearch').value.toLowerCase();
    renderPOSGrid(globalProducts.filter(p => p.name.toLowerCase().includes(query)));
  }

  function renderPOSGrid(productsList) {
    const grid = document.getElementById('posProductGrid');
    if (productsList.length === 0) { grid.innerHTML = `<div class="col-span-full text-center text-slate-400 py-10 text-sm">Produk tidak ditemukan.</div>`; return; }
    grid.innerHTML = productsList.map(p => {
      let badgeHtml = p.badge ? `<div class="absolute top-1 right-1 bg-red-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded shadow-sm z-10">${p.badge}</div>` : '';
      return `
      <div onclick="addToCart('${p.id}')" class="bg-white border border-slate-200 rounded-xl p-3 cursor-pointer hover:border-emerald-500 hover:shadow-md active:scale-95 transition-all group relative">
        <div class="h-20 sm:h-24 w-full bg-slate-100 rounded-lg mb-2 overflow-hidden relative"><img src="${p.img || 'https://placehold.co/100x100/e2e8f0/64748b?text=Box'}" class="w-full h-full object-cover group-hover:scale-110 transition-transform">${badgeHtml}</div>
        <h4 class="font-bold text-slate-800 text-xs sm:text-sm line-clamp-2">${p.name}</h4>
        <p class="text-emerald-600 font-bold text-xs sm:text-sm mt-1">${formatRupiah(p.price)}</p>
      </div>`;
    }).join('');
  }

  function addToCart(id) {
    const product = globalProducts.find(p => p.id === id);
    if (!product) return;
    const existing = cart.find(c => c.id === id);
    if (existing) existing.qty += 1; else cart.push({ ...product, qty: 1 });
    renderCart();
  }

  function renderCart() {
    const list = document.getElementById('cartItemList');
    posSubtotal = 0;
    if (cart.length === 0) {
      list.innerHTML = '<div class="text-center text-slate-400 text-sm mt-10">Keranjang masih kosong</div>';
      document.getElementById('cartSubtotalVal').innerText = 'Rp 0';
      recalculatePOS();
      return;
    }
    list.innerHTML = cart.map((item, index) => {
      const sub = item.price * item.qty; posSubtotal += sub;
      return `
      <div class="flex justify-between items-center bg-white p-2.5 rounded-lg border border-slate-100 shadow-sm">
        <div class="flex-1 pr-3">
          <h4 class="text-xs sm:text-sm font-bold text-slate-800 line-clamp-1">${item.name}</h4>
          <div class="flex items-center gap-2 mt-1">
            <button onclick="changeQty(${index}, -1)" class="w-5 h-5 flex items-center justify-center bg-slate-100 hover:bg-slate-200 rounded text-slate-600 text-xs font-bold">-</button>
            <span class="text-[10px] sm:text-xs font-bold text-slate-600">${item.qty}</span>
            <button onclick="changeQty(${index}, 1)" class="w-5 h-5 flex items-center justify-center bg-slate-100 hover:bg-slate-200 rounded text-slate-600 text-xs font-bold">+</button>
            <span class="text-[9px] sm:text-[10px] text-slate-400">x ${formatRupiah(item.price)}</span>
          </div>
        </div>
        <div class="text-right shrink-0">
          <p class="text-xs sm:text-sm font-bold text-slate-800 mb-1">${formatRupiah(sub)}</p>
          <button onclick="cart.splice(${index},1); renderCart()" class="text-[9px] sm:text-[10px] bg-red-50 text-red-500 hover:bg-red-100 px-2 py-1 rounded">Hapus</button>
        </div>
      </div>`;
    }).join('');
    document.getElementById('cartSubtotalVal').innerText = formatRupiah(posSubtotal);
    recalculatePOS();
  }

  function changeQty(index, delta) {
    cart[index].qty += delta;
    if (cart[index].qty <= 0) cart.splice(index, 1);
    renderCart();
  }

  function clearCart() {
    cart = [];
    document.getElementById('coMeja').value = '';
    document.getElementById('coNama').value = '';
    document.getElementById('coCatatan').value = '';
    renderCart();
  }

  function openCheckoutModal() {
    if (!cart.length) return alert("Keranjang Kosong!");
    document.getElementById('checkoutModal').classList.remove('hidden');
    recalculatePOS();
  }

  function recalculatePOS() {
    let taxSettings = {};
    try { if (currentUser && currentUser.tax_settings) taxSettings = JSON.parse(currentUser.tax_settings); } catch(e) {}
    let ppnPercent = parseFloat(taxSettings.ppn) || 0;
    posServiceVal = parseInt(taxSettings.service) || 0;
    posPpnVal = Math.floor(posSubtotal * (ppnPercent / 100));
    posGrandTotal = Math.max(0, posSubtotal + posPpnVal + posServiceVal);

    const ppnRow = document.getElementById('coPpnRow');
    if (posPpnVal > 0) { ppnRow.classList.remove('hidden'); document.getElementById('coPpnVal').innerText = formatRupiah(posPpnVal); }
    else { ppnRow.classList.add('hidden'); }

    const serviceRow = document.getElementById('coBiayaLayananRow');
    if (posServiceVal > 0) { serviceRow.classList.remove('hidden'); document.getElementById('coBiayaLayananVal').innerText = formatRupiah(posServiceVal); }
    else { serviceRow.classList.add('hidden'); }

    document.getElementById('coGrandTotal').innerText = formatRupiah(posGrandTotal);
    if (document.getElementById('coUangDiterima')) {
      document.getElementById('coUangDiterima').value = posGrandTotal;
      hitungKembalian();
    }
  }

  function toggleKembalian() {
    document.getElementById('cashArea').style.display = document.getElementById('coMethod').value === 'Cash' ? 'block' : 'none';
  }

  function hitungKembalian() {
    let u = parseInt(document.getElementById('coUangDiterima').value) || 0;
    let k = u - posGrandTotal;
    document.getElementById('coKembalian').innerText = k >= 0 ? formatRupiah(k) : "Uang Kurang!";
  }

  async function submitCheckout() {
    const meja = document.getElementById('coMeja').value.trim();
    if (!meja) { alert("Nomor meja wajib diisi!"); return; }
    if (cart.length === 0) return alert("Keranjang kosong!");

    let method = document.getElementById('coMethod').value;
    let uang = method === 'Cash' ? parseInt(document.getElementById('coUangDiterima').value) || 0 : posGrandTotal;
    let change = uang - posGrandTotal;
    if (method === 'Cash' && change < 0) return alert("Uang pembayaran kurang!");

    const btn = document.getElementById('btnSubmitCheckout');
    const originalText = btn.innerHTML;
    btn.innerHTML = `<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Mencetak...`;
    btn.disabled = true;

    const catatan = document.getElementById('coCatatan').value.trim();
    const buyer = document.getElementById('coNama').value || 'Pelanggan Meja ' + meja;
    let localOrderId = "ORD-" + Math.floor(100000 + Math.random() * 900000);

    // 1. CETAK STRUK LANGSUNG
    document.getElementById('strNamaToko').innerText = (currentUser.nama_toko || 'NAMA TOKO').toUpperCase();
    document.getElementById('strInfoToko').innerText = "Admin: " + currentUser.username + " | WA: " + (currentUser.wa_number || '-');
    document.getElementById('strOrderId').innerText = localOrderId;
    document.getElementById('strDate').innerText = new Date().toLocaleString('id-ID');
    document.getElementById('strMeja').innerText = meja;
    document.getElementById('strKasir').innerText = currentUser.username;
    document.getElementById('strPelanggan').innerText = buyer;
    if (catatan) {
      document.getElementById('strCatatanRow').style.display = 'block';
      document.getElementById('strCatatan').innerText = catatan;
    } else {
      document.getElementById('strCatatanRow').style.display = 'none';
    }
    document.getElementById('strSubtotal').innerText = formatRupiah(posSubtotal);
    if (posPpnVal > 0) { document.getElementById('strPpnRow').style.display = 'flex'; document.getElementById('strPpn').innerText = formatRupiah(posPpnVal); } else { document.getElementById('strPpnRow').style.display = 'none'; }
    if (posServiceVal > 0) { document.getElementById('strServiceRow').style.display = 'flex'; document.getElementById('strService').innerText = formatRupiah(posServiceVal); } else { document.getElementById('strServiceRow').style.display = 'none'; }
    document.getElementById('strTotal').innerText = formatRupiah(posGrandTotal);
    document.getElementById('strMethod').innerText = method;
    document.getElementById('strTunai').innerText = formatRupiah(uang);
    document.getElementById('strKembali').innerText = formatRupiah(change);
    document.getElementById('strItems').innerHTML = cart.map(c => `<div style="display:flex; justify-content:space-between; font-size:11px;"><span>${c.name} (${c.qty})</span><span>${formatRupiah(c.price * c.qty)}</span></div>`).join('');

    window.print();

    // 2. KIRIM DATA KE SERVER (background)
    btn.innerHTML = `<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Menyimpan...`;

    let detailPrefix = `[Meja ${meja}]` + (catatan ? ` (Catatan: ${catatan})` : '') + ' ';
    let detail = JSON.stringify(cart.map(c => `${c.name} (${c.qty}${c.unit || 'pcs'})`));
    let apiItemsArr = cart.map(c => ({ id: c.id, variant_id: c.variant_id || null, name: c.name, qty: c.qty, unit: c.unit || 'pcs' }));

    const payload = {
      nama_pembeli: buyer,
      total_belanja: posGrandTotal,
      status: 'Selesai',
      detail_items: detailPrefix + detail,
      detail_items_raw: JSON.stringify(apiItemsArr),
      metode_pembayaran: method,
      uang_bayar: uang,
      kembalian: change,
      subtotal: posSubtotal,
      pajak_ppn: posPpnVal,
      biaya_layanan: posServiceVal,
      // Field tambahan dine-in — perlu kolom di Google Sheet & Apps Script agar tersimpan terpisah
      no_meja: meja,
      catatan: catatan
    };

    try {
      const res = await apiCall('add_order', payload);
      if (res.success) {
        clearCart();
        closeModal('checkoutModal');
      } else {
        alert("Gagal menyimpan pesanan ke database, tapi struk sudah tercetak.");
      }
    } catch (e) {
      console.error("Error Checkout POS Lite: ", e);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
      refreshIcons();
    }
  }

  function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
  function refreshIcons() { if (typeof lucide !== 'undefined') lucide.createIcons(); }

  // INIT
  if (currentUser) {
    document.getElementById('uiUsername').innerText = '@' + currentUser.username;
    loadProducts();
    refreshIcons();
  } else {
    document.body.innerHTML = `<div class="flex flex-col items-center justify-center h-screen w-full bg-slate-50"><h2 class="text-2xl font-bold text-slate-800 mb-2">Akses Ditolak</h2><p class="text-slate-500 mb-4">Sesi habis.</p><a href="login.html" class="px-4 py-2 bg-emerald-500 text-white rounded-lg">Ke Halaman Login</a></div>`;
  }
</script>
</body>
</html>
